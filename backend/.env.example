APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ub_mindset
DB_USERNAME=ub_user
DB_PASSWORD=ub_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# SÉCURITÉ (voir docs/PLAN_BACKEND.md §9)
# ---------------------------------------------------------------------------
# Domaines autorisés pour le CORS : liste explicite, jamais « * » en production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# Domaines « stateful » Sanctum (SPA à cookies).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:5173,127.0.0.1:8000
# Durée de vie des tokens API en minutes (1440 = 24 h).
SANCTUM_EXPIRATION=1440
# Préfixe des tokens (facilite la détection de fuite de secrets).
SANCTUM_TOKEN_PREFIX=ub_
# Compte admin créé par le seeder — OBLIGATOIRE en production (aucun défaut).
ADMIN_SEED_EMAIL=admin@ubmindset.com
ADMIN_SEED_PASSWORD=
# Journal d'audit
LOG_AUDIT_LEVEL=info
LOG_AUDIT_DAYS=90
